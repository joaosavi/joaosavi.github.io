#!/usr/bin/env python3
"""Encerra o agente e a sessão do recover parados há mais de 48 horas, e devolve a memória deles.

Roda pelo sessions-idle.timer, de hora em hora. Arquivar a sessão no app não encerra o processo.
  sessions-idle            encerra
  sessions-idle --dry-run  só lista o que encerraria

O agente sai pelo `agent stop`, que grava o id em ~/.local/state/agents/stopped.jsonl, e a conversa
volta com `agent start <projeto> --name <nome> --resume <id>`. A sessão que o recover abriu pelo app
não volta: a ponte marca "Session failed" e recusa a mensagem seguinte. Por isso o prazo é longo.
O orquestrador nunca é encerrado.
"""

import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
SESSIONS = HOME / ".claude" / "sessions"
PROJECTS = HOME / ".claude" / "projects"
AGENTS = HOME / ".local" / "state" / "agents"


def setting(key):
    """O valor do ambiente ou de ~/.config/always-on/env, o mesmo arquivo que o comando agent lê."""
    if os.environ.get(key):
        return os.environ[key]
    try:
        for line in (HOME / ".config" / "always-on" / "env").read_text().splitlines():
            k, _, v = line.partition("=")
            if k.strip() == key:
                return v.strip()
    except OSError:
        pass
    return ""


ORCHESTRATOR = setting("AGENT_ORCHESTRATOR")
LIMIT = 48 * 3600


def log(msg):
    print(msg, flush=True)


def proc_start(pid):
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def descendants(pid):
    children = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                parent = int((d / "stat").read_text().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            children.setdefault(parent, []).append(int(d.name))
    found, queue = [], [pid]
    while queue:
        for c in children.get(queue.pop(), []):
            found.append(c)
            queue.append(c)
    return found


def last_activity(session_id, since=0):
    """A última escrita no transcript da sessão, ou `since` quando ela ainda não escreveu."""
    last = since
    for transcript in PROJECTS.glob(f"*/{session_id}.jsonl"):
        last = max(last, transcript.stat().st_mtime)
    return last


def kill_tree(pid):
    targets = [pid] + descendants(pid)
    for p in targets:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    time.sleep(10)
    for p in targets:
        try:
            os.kill(p, signal.SIGKILL)
        except ProcessLookupError:
            pass


def idle_agents(now, dry_run):
    for f in sorted(AGENTS.glob("*.json")):
        try:
            spec = json.loads(f.read_text())
        except (ValueError, OSError):
            continue
        if spec.get("name") == ORCHESTRATOR:
            continue
        started = time.mktime(time.strptime(spec["started"], "%Y-%m-%dT%H:%M:%S"))
        idle = now - last_activity(spec["session"], started)
        if idle < LIMIT:
            continue
        log(f"{'encerraria' if dry_run else 'encerrando'} o agente {spec['name']} ({spec['project']}), "
            f"parado há {idle / 3600:.0f} h")
        if not dry_run:
            subprocess.run(["agent", "stop", spec["name"]], check=False)


def idle_bridge_sessions(now, dry_run):
    for f in sorted(SESSIONS.glob("*.json")):
        try:
            s = json.loads(f.read_text())
        except (ValueError, OSError):
            continue
        # Só as sessões que o modo servidor abriu pelo app. As de tmux, como o orquestrador e os
        # agentes, não têm bridgeSessionId.
        if not s.get("bridgeSessionId") or s.get("status") == "busy" or s.get("name") == ORCHESTRATOR:
            continue
        pid = s.get("pid")
        if not pid or proc_start(pid) != str(s.get("procStart")):
            continue
        since = max(s.get("statusUpdatedAt", 0), s.get("updatedAt", 0)) / 1000
        idle = now - last_activity(s.get("sessionId"), since)
        if idle < LIMIT:
            continue
        log(f"{'encerraria' if dry_run else 'encerrando'} {s['bridgeSessionId']} "
            f"({s.get('name')}, pid {pid}), parada há {idle / 3600:.0f} h")
        if not dry_run:
            kill_tree(pid)


def main():
    dry_run = "--dry-run" in sys.argv
    now = time.time()
    idle_agents(now, dry_run)
    idle_bridge_sessions(now, dry_run)


if __name__ == "__main__":
    main()
