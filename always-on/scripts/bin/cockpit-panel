#!/bin/sh
# Roda o painel do Cockpit como serviço, em 127.0.0.1:7777. A pasta do plugin muda a cada versão,
# então ela é lida do installed_plugins.json a cada subida.
dir=$(python3 -c 'import json, os
d = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))
print(d["plugins"]["panel@cockpit"][0]["installPath"])') || exit 1
exec python3 -I "$dir/server/panel.py"
