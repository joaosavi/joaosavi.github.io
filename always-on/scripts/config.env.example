# Copie para config.env e ajuste. O install.sh lê este arquivo, e tudo aqui tem padrão.

# O nome do orquestrador no app. É também a pasta dele em ~/<nome> e o nome do serviço.
# Padrão: o seu usuário.
ORCHESTRATOR=

# O nome do slice dos agentes, sem o .slice. Padrão: agents.
SLICE=agents

# O tamanho do swap em GB, criado só se a máquina não tiver nenhum. 0 não cria.
# Num container o swap vem do host, e o install.sh não cria.
SWAP_GB=8

# Quanto da memória fica fora do slice dos agentes, em MB, além dos 512 MB do recover.
# 1024 cobre o sistema e o Docker. Aumente se os containers dos projetos usam mais.
SYSTEM_MB=1024
